# Copia este archivo como ".env" y pon tus datos reales.
# El archivo .env NUNCA se sube a GitHub (está en el .gitignore).

# Clave secreta de Flask (cualquier texto largo y aleatorio).
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Correo desde el que se envían los códigos para recuperar la contraseña.
# Con Gmail: activa la verificación en dos pasos en la cuenta y crea una
# "contraseña de aplicación" (https://myaccount.google.com/apppasswords).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_cuenta@gmail.com
MAIL_PASSWORD=la_contrasena_de_aplicacion_de_16_letras
# Opcional: dirección que aparece como remitente (por defecto MAIL_USERNAME).
MAIL_SENDER=

# Dirección pública de la página (para los botones de los correos).
APP_URL=http://127.0.0.1:5000

# Ponlo en 1 solo cuando la página esté publicada con HTTPS detrás de un proxy
# (Caddy, Nginx...). Sin HTTPS déjalo en 0, o nadie podrá iniciar sesión.
DETRAS_DE_HTTPS=0
